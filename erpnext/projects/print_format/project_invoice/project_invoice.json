olspan=\"5\" style=\"text-align:right;\"><strong>Net Payable Without GST :</strong></td>-->\r\n\t\t\t<!--  <td colspan=\"3\" style=\"text-align:right;\">{{ frappe.format_value((doc.net_invoice_amount), {\"fieldtype\":\"Currency\"})}}</td>-->\r\n\t\t\t<!--  <td></td>-->\r\n\t\t\t<!--</tr>\t-->\r\n\t\t\t<tr class=\"noBorder\">\r\n\t\t\t  <td colspan=\"5\" style=\"text-align:right;\"><strong>GST :</strong></td>\r\n\t\t\t  <td colspan=\"5\" style=\"text-align:right;\">{{ frappe.format_value((doc.gst_amount), {\"fieldtype\":\"Currency\"})}}</td>\r\n\t\t\t  <td></td>\r\n\t\t\t</tr>\r\n\t\t\t\r\n\t\t\t<tr class=\"noBorder\">\r\n\t\t\t  <td colspan=\"5\" style=\"text-align:right;\"><strong>Total Net Payable With GST :</strong></td>\r\n\t\t\t  <td colspan=\"5\" style=\"text-align:right;\">{{ frappe.format_value((doc.total_gst_amount), {\"fieldtype\":\"Currency\"})}}</td>\r\n\t\t\t  <td></td>\r\n\t\t\t</tr>\t\r\n\t\t</table>\r\n\t</div>\r\n\r\n\t\r\n\t<table  cellpadding= \"0\" cellspacing=\"0\" style=\"margin-top: 10px; border-spacing:0; text-align:right; width:100% \">\r\n        <!--<tr>-->\r\n        <!--  <td colspan =\"5\" style=\"text-align: right;\"><strong>Total: </strong></td>-->\r\n        <!--  <td style=\"text-align: right; width:1% \">{{ frappe.format_value((doc.gross_invoice_amount), {\"fieldtype\":\"Currency\"})}}</td>-->\r\n        <!--</tr>-->\r\n\t\t<tr>\r\n          <td colspan = \"5\" style=\"margin-bottom: 0in; text-align: right\"><strong>Add For Price Adjustment: </strong></td>\r\n          <td style=\"text-align: right; width:1%\">{{ frappe.format_value((doc.price_adjustment_amount), {\"fieldtype\":\"Currency\"})}}</td>\r\n        </tr>\r\n\t\t<tr>\r\n          <td colspan =\"5\" style=\"text-align: right\"><strong>Total including Price Adjustment: </strong></td>\r\n          <td style=\"text-align: right; width:1%\" >{{ frappe.format_value((doc.net_invoice_amount), {\"fieldtype\":\"Currency\"})}}</td>\r\n        </tr>\r\n\t\t<tr>\r\n          <td  col