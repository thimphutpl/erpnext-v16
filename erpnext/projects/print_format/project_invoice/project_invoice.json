 "html": "<div class=\"page-break\">\r\n<div id=\"header-html\" class=\"hidden-pdf\">\r\n    {%- if letter_head and not no_letterhead -%}\r\n        <div class=\"letter-head\">\r\n            {{ letter_head }}\r\n        </div>\r\n    {%- endif -%}\r\n</div>\r\n\r\n\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n    {% if not no_letterhead and footer %}\r\n        <div class=\"letter-head-footer\">\r\n        {{ footer }}\r\n        </div>\r\n    {% endif %}\r\n\r\n    <p class=\"text-center small page-number visible-pdf\">\r\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\r\n    </p>\r\n</div>\r\n<div id=\"main\">\r\n    <div  style=\"text-align: center;\">\r\n        <h3 align = \"center\">TAX INVOICE</h3>\r\n      \r\n       \r\n    \r\n    </div>\r\n\r\n    <div  style=\"text-align: center;\">\r\n        <h4 align = \"center\">(PROJECT INVOICE)</h4>\r\n      \r\n       \r\n    \r\n    </div>\r\n\r\n\r\n\t<div style=\"margin-top: 10px;\">\r\n\t\t<table class = \"table1\" style=\"margin-top: 1px; text-align:justify;font-size:small; width:100% \">\r\n\t\t\t<tr>\r\n\t\t\t\t<td width =\"140\" style = \"width:25%;\"> <strong>Project Name:</strong></td>\r\n\t\t\t\t<td style = \"width:30%;\">{{doc.cost_center}}</td>\r\n\t\t\t\t<td align= \"left\" style=\"width: 15%;\"><strong>Invoice #:</strong></td>\r\n\t\t\t\t<td>{{ doc.name }}</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t\r\n\t\t\t\r\n\t\t\t\t<td><strong>Invoice Date: </strong></td>\r\n\t\t\t\t<td> {{frappe.utils.formatdate(doc.invoice_date)}}</td>\r\n\t\t\t\t<td><strong>Customer:</strong></td>\r\n\t\t\t\t<td>{{ doc.party }}</td>\r\n\t\t\t</tr>\r\n\t\t\t<tr>\r\n\t\t\t    <td><strong> TPN No: </strong></td>\r\n                <td style=\"text-align:left;\"> CAC00045</td>\r\n                <td><strong> GST No: </strong></td>\r\n                <td style=\"text-align:left;\"> C10044814</td>\r\n\t\t\t</tr>\r\n\t\t\t<!--<tr>-->\r\n\t\t\t\t\r\n\t\t\t\t<!--