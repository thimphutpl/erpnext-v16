 "html": "<div class=\"page-break\">\r\n    <div id=\"header-html\" class=\"hidden-pdf\">\r\n        {%- if letter_head and not no_letterhead -%}\r\n        <div class=\"letter-head\">\r\n            {{ letter_head }}\r\n        </div>\r\n        {%- endif -%}\r\n    </div>\r\n    <div style=\"width: 100%; display: flex; justify-content: space-between; align-items: center;\">\r\n    <div style=\"float: left; text-align: left;\">\r\n        <p style=\"margin: 0;\">No: GBCL/ADM-10/2025/</p>\r\n    </div>\r\n    <div style=\"float: right; text-align: right;\">\r\n        <p style=\"margin: 0;\">{{ frappe.format_value(doc.posting_date ,{'fieldtype': 'Date'}) }}</p>\r\n    </div>\r\n</div>\r\n    <br/>\r\n    <div id=\"main\">\r\n        <div style=\"text-align: left; margin-bottom: 20px;\">\r\n            <p>To</p>\r\n            <p>{{doc.party }}</p>\r\n            <p>{{ frappe.db.get_value(\"Supplier\", doc.party, \"location\") or \"\" }}</p>\r\n\r\n        </div>\r\n\r\n        <div style=\"text-align: left; margin-bottom: 20px;\">\r\n            <p><strong>Subject: <u>Vehicle Repair and Service Order</u></strong></p>\r\n        </div>\r\n\r\n        <div style=\"text-align: justify; margin-bottom: 20px;\">\r\n            <p>Sir/Madam,</p>\r\n            <p>Kindly supply and repair the vehicle No <strong>{{ doc.equipment }}</strong> as per the estimated rate provided as detailed below.</p>\r\n        </div>\r\n\r\n        <table class=\"table table-condensed\" style=\"width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 20px;\">\r\n            <thead>\r\n                <tr>\r\n                    <th style=\"width: 5%; text-align: center; border: 1px solid #000;\"><strong>Sl. No</strong></th>\r\n                    <th style=\"width: 40%; text-align: left; border: 1px solid #000;\"><strong>Items & Description</strong></th>\r\n                    <th style=\"width: 10%; text-align: center; border: 1px solid #000;\"><strong>Qty</strong></th>\r\n                    <th style=\"width: 20%; text-align: right; border: 1px solid #000;\"><strong>Rate</strong></th>\r\n                    <th style=\"width: 15%; text-align: right; border: 1px solid #000;\"><strong>Amount</strong></th>\r\n                </tr>\r\n            </thead>\r\n            <tbody>\r\n                {%- for item in doc.items -%}\r\n                <tr>\r\n                    <td style=\"text-align: center; border: 1px solid #000;\">{{ loop.index }}</td>\r\n                    <td style=\"text-align: left; border: 1px solid #000;\">\r\n                        {{ item.item_name }}<br>\r\n                    </td>\r\n                    <td style=\"text-align: center; border: 1px solid #000;\">{{ item.qty }}</td>\r\n                    <td style=\"text-align: right; border: 1px solid #000;\">{{ frappe.format_value(item.rate, {'fieldtype': 'Currency'}) }}</td>\r\n                    <td style=\"text-align: right; border: 1px solid #000;\">{{ frappe.format_value(item.charge_amount, {'fieldtype': 'Currency'}) }}</td>\r\n                </tr>\r\n                {%- endfor -%}\r\n                <tr>\r\n                    <td colspan=\"4\" style=\"text-align: center; border: 1px solid #000;\"><strong>Total</strong></td>\r\n                    <td style=\"text-align: right; border: 1px solid #000;\"><strong>{{ frappe.format_value(doc.total_amount, {'fieldtype': 'Currency'}) }}</strong></td>\r\n                </tr>\r\n            </tbody>\r\n        </table>\r\n\r\n        <div style=\"margin-bottom: 40px;\">\r\n            <p>Please send the bill to this office for payment.</p>\r\n            <p>Thanking You,</p>\r\n        </div>\r\n\r\n        <div style=\"margin-bottom: 20px;\">\r\n                <p>{{ frappe.db.get_value(\"Employee\", {\"user_id\":doc.owner}, \"employee_name\") }}</p>\r\n\t\t\t\t<p>{{ frappe.db.get_value(\"Employee\", {\"user_id\":doc.owner}, \"designation\") }}</p>\r\n\t\t\t\t<p>{{ frappe.db.get_value(\"Employee\", {\"user_id\":doc.owner}, \"cost_center\") }}</p>\r\n        </div>\r\n\r\n        <div style=\"margin-top: 30px;\">\r\n            <p><strong>Copy to:</strong></p>\r\n            <ol>\r\n                <li>The Hon'ble CEO, for kind information</li>\r\n                <li>GM, OPD for kind information</li>\r\n                <li>Head (FAS) for information</li>\r\n                <li>Office copy</li>\r\n            </ol>\r\n        </div>\r\n    </div>\r\n\r\n  <div id=\"footer-html\">\r\n    <div style=\"text-align: center;\">This print is system generated and should be considered VALID without appropriate seal and/or signature</div>\r\n    <hr style=\"height: 3px; background: #550000;\">\r\n    <div style=\"text-align: center;\">Phone No. 02-350642 (CEO), 02-350643 (PABX, 02-350644 (FAX), Post Box No. 1919)</div>\r\n\r\n</div>\r\n</div>",
